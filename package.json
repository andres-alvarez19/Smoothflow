{
  "name": "smoothflow",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @smoothflow/shared build && pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "test": "pnpm --filter @smoothflow/api --filter @smoothflow/shared test",
    "test:bdd": "pnpm --filter @smoothflow/api test:bdd",
    "bdd:db:up": "docker compose -f docker-compose.bdd.yml up -d",
    "bdd:db:down": "docker compose -f docker-compose.bdd.yml down"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "leveldown"
    ]
  }
}
