{
  "name": "smoothflow",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @smoothflow/shared build && pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "test": "pnpm --filter @smoothflow/api --filter @smoothflow/shared test",
    "test:bdd": "pnpm --filter @smoothflow/api test:bdd"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "leveldown"]
  }
}
